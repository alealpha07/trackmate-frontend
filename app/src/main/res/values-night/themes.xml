<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TrackMate" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary_200</item>
        <item name="colorPrimaryVariant">@color/primary_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- keeps the teal app bar instead of a grey one -->
        <item name="actionBarStyle">@style/TrackMateActionBar</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="TrackMateActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/primary_700</item>
    </style>
</resources>
