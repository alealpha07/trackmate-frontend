<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="50dp">

        <TextView
            android:id="@+id/txtTrackName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Track Name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="16dp" />

        <TextView
            android:id="@+id/txtTrackLength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Length: -- km"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/txtTrackName"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/txtUserTravelCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Travels: --"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@id/txtTrackLength"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/title_distribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speed Comparison"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/txtTrackLength"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_margin="16dp" />

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/barChart"
            android:layout_width="0dp"
            android:layout_height="200dp"
            app:layout_constraintTop_toBottomOf="@id/title_distribution"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="16dp" />

        <TextView
            android:id="@+id/title_user_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Show data for"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/barChart"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp" />

        <Spinner
            android:id="@+id/spinnerUsers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/title_user_filter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/title_performance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Performance over Time"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/spinnerUsers"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_margin="16dp" />

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/performanceChart"
            android:layout_width="0dp"
            android:layout_height="200dp"
            app:layout_constraintTop_toBottomOf="@id/title_performance"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="16dp" />

        <TextView
            android:id="@+id/title_speed_map"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speed Map"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/performanceChart"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_margin="16dp" />

        <!-- Holds speedMapSection inline; the section is moved into fullscreenContainer
             while fullscreen, and this slot keeps its height so the page doesn't jump. -->
        <FrameLayout
            android:id="@+id/speedMapSlot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/title_speed_map"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/speedMapSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <Spinner
                    android:id="@+id/spinnerTravels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <FrameLayout
                    android:id="@+id/speedMapFrame"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="8dp">

                    <org.osmdroid.views.MapView
                        android:id="@+id/speedMapView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="8dp"
                        android:orientation="vertical">

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/btnSpeedMapFullscreen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:contentDescription="Open fullscreen"
                            app:fabSize="mini"
                            app:srcCompat="@drawable/ic_fullscreen_24"
                            app:tint="@android:color/black"
                            app:backgroundTint="@android:color/white" />

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/btnSpeedMapZoomIn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:contentDescription="Zoom in"
                            android:visibility="gone"
                            app:fabSize="mini"
                            app:srcCompat="@drawable/ic_add_24"
                            app:tint="@android:color/black"
                            app:backgroundTint="@android:color/white" />

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/btnSpeedMapZoomOut"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="Zoom out"
                            android:visibility="gone"
                            app:fabSize="mini"
                            app:srcCompat="@drawable/ic_remove_24"
                            app:tint="@android:color/black"
                            app:backgroundTint="@android:color/white" />

                    </LinearLayout>

                </FrameLayout>

                <View
                    android:id="@+id/speedLegendBar"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtSpeedMin"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:text="-- km/h"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtSpeedMark1"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="-- km/h"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtSpeedMark2"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="-- km/h"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtSpeedMax"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="-- km/h"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/title_leaderboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Leaderboard Top 10"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/speedMapSlot"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_margin="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/leaderboardRecycler"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/title_leaderboard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:listitem="@layout/item_user_leaderboard"  />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

    <!-- speedMapSection is reparented here while the speed map is fullscreen. -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/windowBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:visibility="gone" />

</FrameLayout>
