<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".navigate.Navigate"
    android:paddingBottom="50dp">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/mapCredit"
        layout="@layout/view_map_credit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/rideStats"
        layout="@layout/view_ride_stats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/mapControls" />

    <LinearLayout
        android:id="@+id/mapControls"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- only while recording -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnCompass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/map_lock_north"
            android:visibility="gone"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_compass_needle_24"
            app:tint="@null"
            app:backgroundTint="@color/map_control" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnLayers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/map_style"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_layers_24"
            app:tint="@color/map_control_icon"
            app:backgroundTint="@color/map_control" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/map_my_location"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_my_location_24"
            app:tint="@color/map_control_icon"
            app:backgroundTint="@color/map_control" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnZoomIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:contentDescription="@string/map_zoom_in"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_add_24"
            app:tint="@color/map_control_icon"
            app:backgroundTint="@color/map_control" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnZoomOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/map_zoom_out"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_remove_24"
            app:tint="@color/map_control_icon"
            app:backgroundTint="@color/map_control" />

    </LinearLayout>

    <!-- the last two are hidden while recording -->
    <Button
        android:id="@+id/btnRecord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/record_start"
        app:layout_constraintBottom_toTopOf="@id/btnPlanRoute"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_goneMarginBottom="64dp" />

    <Button
        android:id="@+id/btnPlanRoute"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/plan_open"
        app:layout_constraintBottom_toTopOf="@id/btnOpenLibrary"
        app:layout_constraintStart_toStartOf="@id/btnOpenLibrary"
        app:layout_constraintEnd_toEndOf="@id/btnOpenLibrary"
        app:icon="@drawable/ic_route_24"
        app:iconGravity="textStart"
        android:backgroundTint="@color/map_control"
        style="?attr/materialButtonOutlinedStyle"/>

    <Button
        android:id="@+id/btnOpenLibrary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/saved_tracks"
        app:layout_constraintBottom_toTopOf="@id/mapCredit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="4dp"
        app:icon="@drawable/baseline_menu_24"
        android:backgroundTint="@color/map_control"
        style="?attr/materialButtonOutlinedStyle"/>

</androidx.constraintlayout.widget.ConstraintLayout>
