<?xml version="1.0" encoding="utf-8"?>
<!-- The travel's vehicle, asked on Start when more than one of the track's class is in the profile -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/travelVehicleToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTravelCar"
            style="@style/VehicleToggleButton"
            android:layout_width="wrap_content"
            android:layout_weight="0"
            android:textAllCaps="false"
            android:text="@string/vehicle_car"
            app:icon="@drawable/ic_vehicle_car_24"
            app:iconPadding="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTravelMotorcycle"
            style="@style/VehicleToggleButton"
            android:layout_width="wrap_content"
            android:layout_weight="0"
            android:textAllCaps="false"
            android:text="@string/vehicle_motorcycle"
            app:icon="@drawable/ic_vehicle_motorcycle_24"
            app:iconPadding="8dp" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

</LinearLayout>
