<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".track.TrackNavigation"
    android:paddingBottom="50dp">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/mapCredit"
        layout="@layout/view_map_credit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/navBanner"
        layout="@layout/view_navigation_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/mapControls" />

    <include
        android:id="@+id/rideStats"
        layout="@layout/view_ride_stats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        app:layout_goneMarginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/navBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/mapControls" />

    <LinearLayout
        android:id="@+id/mapControls"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- only while navigating -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnCompass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/map_lock_north"
            android:visibility="gone"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_compass_needle_24"
            app:tint="@null"
            app:backgroundTint="@color/map_control" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnLayers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/map_style"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_layers_24"
            app:tint="@color/map_control_icon"
            app:backgroundTint="@color/map_control" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/map_my_location"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_my_location_24"
            app:tint="@color/map_control_icon"
            app:backgroundTint="@color/map_control" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnZoomIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:contentDescription="@string/map_zoom_in"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_add_24"
            app:tint="@color/map_control_icon"
            app:backgroundTint="@color/map_control" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnZoomOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/map_zoom_out"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_remove_24"
            app:tint="@color/map_control_icon"
            app:backgroundTint="@color/map_control" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/statsLayout"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/map_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/btnRecord"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtTrackName"
            tools:text="Track Name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"/>

        <TextView
            android:id="@+id/txtTrackVehicle"
            android:textSize="16sp"
            android:drawablePadding="8dp"
            android:drawableTint="?android:attr/textColorSecondary"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"/>

        <TextView
            android:id="@+id/txtVehicleMissing"
            android:textSize="16sp"
            android:textColor="@color/danger"
            android:visibility="gone"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"/>

        <TextView
            android:id="@+id/txtTrackLength"
            tools:text="Length: 0.00 km"
            android:textSize="16sp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"/>

        <TextView
            android:id="@+id/txtUserBest"
            tools:text="Your Best: -"
            android:textSize="16sp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content" />

        <TextView
            android:id="@+id/txtUserBestAvg"
            tools:text="Your Best Average Speed: -"
            android:textSize="16sp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content" />

        <TextView
            android:id="@+id/txtUserBestSpd"
            tools:text="Your Best Speed: -"
            android:textSize="16sp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content" />

        <Button
            android:id="@+id/btnMoreDetails"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/track_more_details"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/map_control"
            style="?attr/materialButtonOutlinedStyle"/>

    </LinearLayout>

    <Button
        android:id="@+id/btnRecord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/navigation_start"
        app:layout_constraintBottom_toTopOf="@id/mapCredit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:enabled="false"
        android:layout_marginBottom="8dp" />


</androidx.constraintlayout.widget.ConstraintLayout>
