<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/loginRegister">

    <fragment
        android:id="@+id/home"
        android:name="com.example.trackmate.home.Home"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_home_to_userProfile"
            app:destination="@id/userProfile" />
        <action
            android:id="@+id/action_home_to_trackNavigation"
            app:destination="@id/trackNavigation" />
    </fragment>
    <fragment
        android:id="@+id/search"
        android:name="com.example.trackmate.search.Search"
        android:label="@string/title_search"
        tools:layout="@layout/fragment_search" >
        <action
            android:id="@+id/action_search_to_userProfile2"
            app:destination="@id/userProfile" />
        <action
            android:id="@+id/action_search_to_trackNavigation"
            app:destination="@id/trackNavigation" />
    </fragment>
    <fragment
        android:id="@+id/navigate"
        android:name="com.example.trackmate.navigate.Navigate"
        android:label="@string/title_navigate"
        tools:layout="@layout/fragment_navigate" >
        <action
            android:id="@+id/action_navigate_to_trackNavigation"
            app:destination="@id/trackNavigation" />
    </fragment>
    <fragment
        android:id="@+id/quests"
        android:name="com.example.trackmate.quests.Quests"
        android:label="@string/title_scoreboard"
        tools:layout="@layout/fragment_quests" />
    <fragment
        android:id="@+id/profile"
        android:name="com.example.trackmate.profile.Profile"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profile_to_trackNavigation"
            app:destination="@id/trackNavigation" />
    </fragment>
    <fragment
        android:id="@+id/trackNavigation"
        android:name="com.example.trackmate.track.TrackNavigation"
        android:label="@string/nav_navigation"
        tools:layout="@layout/fragment_track_navigation" >
        <argument
            android:name="trackId"
            app:argType="integer"
            android:defaultValue="-1" />
        <action
            android:id="@+id/action_trackNavigation_to_travelGraph"
            app:destination="@id/travelGraph" />
    </fragment>
    <fragment
        android:id="@+id/savedTracks"
        android:name="com.example.trackmate.navigate.SavedTracks"
        android:label="@string/saved_tracks"
        tools:layout="@layout/fragment_saved_tracks" >
        <action
            android:id="@+id/action_savedTracks_to_trackNavigation"
            app:destination="@id/trackNavigation" />
    </fragment>
    <fragment
        android:id="@+id/trackPlanner"
        android:name="com.example.trackmate.planner.TrackPlanner"
        android:label="@string/plan_title"
        tools:layout="@layout/fragment_track_planner" >
        <action
            android:id="@+id/action_trackPlanner_to_trackNavigation"
            app:destination="@id/trackNavigation" />
    </fragment>
    <fragment
        android:id="@+id/loginRegister"
        android:name="com.example.trackmate.LoginRegister"
        android:label="@string/nav_sign_in"
        tools:layout="@layout/fragment_login_register" />
    <fragment
        android:id="@+id/settings"
        android:name="com.example.trackmate.profile.Settings"
        android:label="@string/settings_title"
        tools:layout="@layout/fragment_settings" />
    <fragment
        android:id="@+id/credits"
        android:name="com.example.trackmate.profile.Credits"
        android:label="@string/credits_title"
        tools:layout="@layout/fragment_credits" />
    <fragment
        android:id="@+id/legal"
        android:name="com.example.trackmate.profile.LegalPage"
        android:label="@string/legal_privacy"
        tools:layout="@layout/fragment_legal">
        <argument
            android:name="page"
            app:argType="string"
            android:defaultValue="privacy" />
    </fragment>
    <fragment
        android:id="@+id/profileEdit"
        android:name="com.example.trackmate.profile.ProfileEdit"
        android:label="@string/profile_edit"
        tools:layout="@layout/fragment_profile_edit" />
    <fragment
        android:id="@+id/userProfile"
        android:name="com.example.trackmate.profile.UserProfile"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_user_profile">
        <argument
            android:name="id"
            app:argType="integer" />
        <action
            android:id="@+id/action_userProfile_to_trackNavigation"
            app:destination="@id/trackNavigation" />
    </fragment>
    <fragment
        android:id="@+id/friends"
        android:name="com.example.trackmate.profile.Friends"
        android:label="@string/friends_title"
        tools:layout="@layout/fragment_friends">
        <action
            android:id="@+id/action_friends_to_userProfile"
            app:destination="@id/userProfile" />
    </fragment>
    <fragment
        android:id="@+id/createPost"
        android:name="com.example.trackmate.profile.CreatePost"
        android:label="@string/post_new"
        tools:layout="@layout/fragment_create_post" />
    <fragment
        android:id="@+id/bookmarks"
        android:name="com.example.trackmate.profile.Bookmarks"
        android:label="@string/saved_posts"
        tools:layout="@layout/fragment_bookmarks" >
        <action
            android:id="@+id/action_bookmarks_to_userProfile"
            app:destination="@id/userProfile" />
        <action
            android:id="@+id/action_bookmarks_to_trackNavigation"
            app:destination="@id/trackNavigation" />
    </fragment>
    <fragment
        android:id="@+id/travels"
        android:name="com.example.trackmate.profile.Travels"
        android:label="@string/travels_history"
        tools:layout="@layout/fragment_travels">
        <action
            android:id="@+id/action_travels_to_trackNavigation"
            app:destination="@id/trackNavigation" />
    </fragment>
    <fragment
        android:id="@+id/travelGraph"
        android:name="com.example.trackmate.track.TravelGraph"
        android:label="@string/nav_track_details"
        tools:layout="@layout/fragment_travel_graph">
        <argument
            android:name="trackId"
            android:defaultValue="-1"
            app:argType="integer" />
        <argument
            android:name="trackKm"
            android:defaultValue="-1.0"
            app:argType="float" />
    </fragment>
</navigation>